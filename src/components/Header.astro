---
const currentPath = Astro.url.pathname;

const NAV = [
  { href: '/', label: 'Salary Calculator', match: (p) => p === '/' },
  { href: '/in-hand-salary/', label: 'All Slabs', match: (p) => p.startsWith('/in-hand-salary') },
  { href: '/income-tax/', label: 'Income Tax', match: (p) => p.startsWith('/income-tax') },
  { href: '/tools/home-loan-emi/', label: 'Loan EMI', match: (p) => p.startsWith('/tools/home-loan-emi') },
  { href: '/tools/sip-calculator/', label: 'Step-Up SIP', match: (p) => p.startsWith('/tools/sip-calculator') },
  { href: '/tools/salary-hike/', label: 'Salary Hike', match: (p) => p.startsWith('/tools/salary-hike') }
];

const links = NAV.map(item => ({ ...item, active: item.match(currentPath) }));
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
  <div class="container flex items-center justify-between h-16 gap-3">
    <div class="flex items-center gap-6 min-w-0">
      <a href="/" class="flex items-center gap-1.5 text-xl font-extrabold tracking-tight text-slate-900 group shrink-0">
        <span>InHand</span><span class="text-teal-600 group-hover:translate-x-0.5 transition-transform">.</span>
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
        {links.map(item => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${item.active ? 'bg-slate-100 text-teal-800' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200/60">
        <span class="w-1.5 h-1.5 rounded-full bg-teal-600 animate-pulse"></span>
        FY 2025–26 &amp; 2026–27
      </span>

      <!-- Mobile menu trigger -->
      <button
        type="button"
        id="nav-toggle"
        class="lg:hidden inline-flex items-center justify-center gap-2 h-10 px-3 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg data-icon="open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg data-icon="close" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" hidden>
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="text-sm font-semibold">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation panel -->
  <nav
    id="mobile-nav"
    class="lg:hidden hidden border-t border-slate-200 bg-white"
    aria-label="Primary mobile"
  >
    <div class="container py-3">
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
        {links.map(item => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class={`flex items-center justify-between px-3 py-3 rounded-lg text-sm font-semibold transition-colors ${item.active ? 'bg-teal-50 text-teal-800 border border-teal-200/60' : 'text-slate-700 hover:bg-slate-50 border border-transparent'}`}
            >
              {item.label}
              {item.active && <span class="text-[10px] uppercase tracking-wider font-bold text-teal-600">Current</span>}
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200/60">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
          FY 2025–26 &amp; 2026–27
        </span>
        <a href="/methodology/" class="text-xs font-semibold text-slate-500 hover:text-teal-700">
          Methodology
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('mobile-nav');
    if (!toggle || !panel) return;

    var iconOpen = toggle.querySelector('[data-icon="open"]');
    var iconClose = toggle.querySelector('[data-icon="close"]');

    // NOTE: use toggleAttribute, not `.hidden`. SVGElement does not implement
    // the hidden IDL property (only HTMLElement does), so `svg.hidden = true`
    // silently sets a useless JS expando and never updates the attribute.
    function setOpen(open) {
      panel.toggleAttribute('hidden', !open);
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      if (iconOpen) iconOpen.toggleAttribute('hidden', open);
      if (iconClose) iconClose.toggleAttribute('hidden', !open);
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Clicking outside the header dismisses the panel.
    document.addEventListener('click', function (e) {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (!panel.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
    });

    // Reset state if the viewport grows into the desktop nav.
    var desktop = window.matchMedia('(min-width: 1024px)');
    var onChange = function (e) { if (e.matches) setOpen(false); };
    if (desktop.addEventListener) desktop.addEventListener('change', onChange);
    else if (desktop.addListener) desktop.addListener(onChange);
  })();
</script>
