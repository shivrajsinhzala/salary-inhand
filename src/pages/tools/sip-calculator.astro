---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { calculateStepUpSIP, calculateSIP } from '../../lib/math/sip.js';
import { formatINR } from '../../lib/format.js';

const initialMonthly = 15000;
const initialStepUp = 10;
const initialReturn = 12;
const initialYears = 12;

const stepUpData = calculateStepUpSIP(initialMonthly, initialStepUp, initialReturn, initialYears);
const regularData = calculateSIP(initialMonthly, initialReturn, initialYears);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Step-Up SIP & Mutual Fund Calculator",
      "url": "https://salary.shivrajsinh.in/tools/sip-calculator/",
      "description": "Calculate future wealth growth with regular and step-up mutual fund SIP investments.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Any"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://salary.shivrajsinh.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Step-Up SIP Calculator",
          "item": "https://salary.shivrajsinh.in/tools/sip-calculator/"
        }
      ]
    }
  ]
};
---
<Layout
  title="Step-Up SIP Calculator — Compound Wealth with Annual Increments | InHand."
  description="Calculate your mutual fund SIP wealth growth with an annual step-up percentage. See how increasing your monthly investment by 10% each year doubles your retirement corpus."
  canonicalUrl="https://salary.shivrajsinh.in/tools/sip-calculator/"
  schemaJson={schema}
>
  <div class="container">
    <nav class="text-xs text-slate-500 mb-4 flex items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-teal-700">Home</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Step-Up SIP Calculator</span>
    </nav>

    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 mb-3 border border-emerald-200/50">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        <span>Wealth Compounding with Annual Increments</span>
      </div>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Step-Up SIP Wealth Calculator
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl">
        As your salary increases each year with appraisals, your investments should too. See how increasing your monthly SIP by just 10% annually creates massive wealth.
      </p>
    </div>

    <!-- Top AdSlot -->
    <AdSlot format="horizontal" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-8">
      <!-- Left: Inputs -->
      <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-6">
        <!-- Monthly Investment -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="sip-monthly-input" class="text-sm font-bold text-slate-900">Starting Monthly Investment</label>
            <span id="sip-monthly-label" class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 tnum">₹15,000/mo</span>
          </div>
          <div class="relative flex items-center">
            <span class="absolute left-3.5 text-slate-400 font-semibold pointer-events-none">₹</span>
            <input 
              type="number" 
              id="sip-monthly-input" 
              value={initialMonthly} 
              step="1000"
              class="w-full pl-8 pr-4 py-3 rounded-xl border border-slate-200 text-lg font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 tnum bg-slate-50/50"
            />
          </div>
          <input type="range" id="sip-monthly-slider" min="1000" max="100000" step="1000" value={initialMonthly} class="w-full mt-3" />
        </div>

        <!-- Annual Step-Up -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="sip-stepup-input" class="text-sm font-bold text-slate-900">Annual Step-Up (% increase / year)</label>
            <span id="sip-stepup-label" class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 tnum">10% / year</span>
          </div>
          <input type="range" id="sip-stepup-slider" min="0" max="25" step="1" value={initialStepUp} class="w-full" />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1 font-medium tnum">
            <span>0% (Flat SIP)</span>
            <span>5%</span>
            <span>10% (Recommended)</span>
            <span>20%</span>
          </div>
        </div>

        <!-- Expected Return Rate -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="sip-return-input" class="text-sm font-bold text-slate-900">Expected Annual Return (% CAGR)</label>
            <span id="sip-return-label" class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-800 tnum">12%</span>
          </div>
          <input type="range" id="sip-return-slider" min="8" max="18" step="0.5" value={initialReturn} class="w-full" />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1 font-medium tnum">
            <span>8% (Debt/Hybrid)</span>
            <span>12% (Nifty Index)</span>
            <span>15% (Mid/Small Cap)</span>
          </div>
        </div>

        <!-- Time Period -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <label for="sip-tenure-input" class="text-sm font-bold text-slate-900">Investment Tenure</label>
            <span id="sip-tenure-label" class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-800 tnum">12 Years</span>
          </div>
          <input type="range" id="sip-tenure-slider" min="1" max="30" step="1" value={initialYears} class="w-full" />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1 font-medium tnum">
            <span>3 Years</span>
            <span>10 Years</span>
            <span>20 Years</span>
            <span>30 Years</span>
          </div>
        </div>
      </div>

      <!-- Right: Wealth Summary Card -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-900 text-white rounded-2xl p-7 shadow-lg border border-slate-800 relative overflow-hidden">
          <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2">Expected Maturity Value</div>
          <div class="flex items-baseline gap-2">
            <span id="sip-maturity-display" class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight tnum">
              {formatINR(stepUpData.maturityValue)}
            </span>
          </div>

          <div class="mt-6 pt-5 border-t border-slate-800 grid grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-slate-400 block">Total Invested</span>
              <strong id="sip-invested-display" class="text-sm font-bold text-slate-200 block mt-0.5 tnum">{formatINR(stepUpData.totalInvested)}</strong>
            </div>
            <div>
              <span class="text-slate-400 block">Est. Returns (Wealth Gain)</span>
              <strong id="sip-returns-display" class="text-sm font-bold text-emerald-400 block mt-0.5 tnum">{formatINR(stepUpData.estimatedReturns)}</strong>
            </div>
          </div>

          <!-- Step Up vs Flat Advantage -->
          <div class="mt-6 p-4 rounded-xl bg-teal-950/80 border border-teal-500/40 text-teal-200">
            <div class="flex items-center gap-1.5 text-xs font-bold text-teal-300 uppercase tracking-wide">
              <svg class="w-3.5 h-3.5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
              <span>The Step-Up Advantage</span>
            </div>
            <div class="mt-1 text-base font-bold text-white tnum" id="sip-bonus-display">
              + {formatINR(stepUpData.maturityValue - regularData.maturityValue)} extra wealth
            </div>
            <p class="text-xs text-teal-200/80 mt-1 leading-relaxed">
              Compared to a flat non-increasing SIP of ₹{initialMonthly.toLocaleString('en-IN')}/mo!
            </p>
          </div>
        </div>

        <div class="p-5 bg-white border border-slate-200 rounded-xl text-xs text-slate-600 space-y-2">
          <h3 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Key Investment Principles</span>
          </h3>
          <p>• <strong>Automate with appraisal:</strong> Set your mutual fund mandate to auto-step up 10% in April or May when appraisals take effect.</p>
          <p>• <strong>Power of Compounding:</strong> In a 15-year SIP, more than 60% of the final maturity corpus comes from compounding returns, not your invested principal!</p>
        </div>
      </div>
    </div>

    <!-- Bottom AdSlot -->
    <AdSlot format="horizontal" />
  </div>
</Layout>

<script>
  import { calculateStepUpSIP, calculateSIP } from '../../lib/math/sip.js';
  import { formatINR } from '../../lib/format.js';

  function initSipCalc() {
    const monthlyInput = document.getElementById('sip-monthly-input') as HTMLInputElement;
    const monthlySlider = document.getElementById('sip-monthly-slider') as HTMLInputElement;
    const monthlyLabel = document.getElementById('sip-monthly-label');
    const stepUpSlider = document.getElementById('sip-stepup-slider') as HTMLInputElement;
    const stepUpLabel = document.getElementById('sip-stepup-label');
    const returnSlider = document.getElementById('sip-return-slider') as HTMLInputElement;
    const returnLabel = document.getElementById('sip-return-label');
    const tenureSlider = document.getElementById('sip-tenure-slider') as HTMLInputElement;
    const tenureLabel = document.getElementById('sip-tenure-label');

    const maturityDisp = document.getElementById('sip-maturity-display');
    const investedDisp = document.getElementById('sip-invested-display');
    const returnsDisp = document.getElementById('sip-returns-display');
    const bonusDisp = document.getElementById('sip-bonus-display');

    function update() {
      const m = Number(monthlyInput?.value) || 15000;
      const s = Number(stepUpSlider?.value) || 0;
      const r = Number(returnSlider?.value) || 12;
      const t = Number(tenureSlider?.value) || 12;

      if (monthlyLabel) monthlyLabel.textContent = `₹${m.toLocaleString('en-IN')}/mo`;
      if (stepUpLabel) stepUpLabel.textContent = `${s}% / year`;
      if (returnLabel) returnLabel.textContent = `${r}%`;
      if (tenureLabel) tenureLabel.textContent = `${t} Years`;

      const stepUp = calculateStepUpSIP(m, s, r, t);
      const regular = calculateSIP(m, r, t);
      const bonus = Math.max(0, stepUp.maturityValue - regular.maturityValue);

      if (maturityDisp) maturityDisp.textContent = formatINR(stepUp.maturityValue);
      if (investedDisp) investedDisp.textContent = formatINR(stepUp.totalInvested);
      if (returnsDisp) returnsDisp.textContent = formatINR(stepUp.estimatedReturns);
      if (bonusDisp) bonusDisp.textContent = `+ ${formatINR(bonus)} extra wealth`;
    }

    monthlyInput?.addEventListener('input', () => { if (monthlySlider) monthlySlider.value = monthlyInput.value; update(); });
    monthlySlider?.addEventListener('input', () => { if (monthlyInput) monthlyInput.value = monthlySlider.value; update(); });
    stepUpSlider?.addEventListener('input', update);
    returnSlider?.addEventListener('input', update);
    tenureSlider?.addEventListener('input', update);
  }

  initSipCalc();
</script>
