---
interface Props {
  monthlyInHand?: number;
}

const { monthlyInHand = 80000 } = Astro.props;
const estimatedLoanLakhs = Math.round((monthlyInHand * 0.50 * 115) / 100000); // approx loan capacity
const suggestedSip = Math.round(monthlyInHand * 0.20);
---
<section class="my-10 pt-6 border-t border-slate-200">
  <div class="mb-6">
    <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
      Next Steps with your In-Hand Salary
    </span>
    <h2 class="text-xl font-bold text-slate-900 mt-2">Plan your loans & investments</h2>
    <p class="text-sm text-slate-500">Make your monthly take-home salary work harder for you.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Bridge 1: Home Loan -->
    <a 
      href="/tools/home-loan-emi/" 
      class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-teal-500 hover:shadow-md transition-all flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="w-8 h-8 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-base">
            🏠
          </span>
          <span class="text-xs font-semibold text-teal-700 group-hover:translate-x-1 transition-transform">
            Calculate →
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
          Home Loan Affordability
        </h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
          Based on your take-home, you could qualify for up to <strong class="text-slate-800">₹{estimatedLoanLakhs} Lakhs</strong> in home loan. See how prepaying saves ₹10L+ interest.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 font-medium">
        <span>Banks FOIR: 50% max</span>
        <span class="text-teal-600 font-semibold">Loan EMI Tool</span>
      </div>
    </a>

    <!-- Bridge 2: Step-Up SIP -->
    <a 
      href="/tools/sip-calculator/" 
      class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-teal-500 hover:shadow-md transition-all flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-base">
            📈
          </span>
          <span class="text-xs font-semibold text-emerald-700 group-hover:translate-x-1 transition-transform">
            Simulate →
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
          Step-Up SIP Compounder
        </h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
          Investing 20% (<strong class="text-slate-800">₹{suggestedSip.toLocaleString('en-IN')}/mo</strong>) with a 10% yearly increment can build massive long-term wealth.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 font-medium">
        <span>12% assumed CAGR</span>
        <span class="text-emerald-600 font-semibold">Wealth Tool</span>
      </div>
    </a>

    <!-- Bridge 3: Salary Hike -->
    <a 
      href="/tools/salary-hike/" 
      class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-teal-500 hover:shadow-md transition-all flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-base">
            💼
          </span>
          <span class="text-xs font-semibold text-indigo-700 group-hover:translate-x-1 transition-transform">
            Evaluate →
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-indigo-700 transition-colors">
          Salary Hike & Appraisal
        </h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
          Evaluating a 20%, 30%, or 50% job offer jump? Find out exactly how much extra cash hits your bank account after tax.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 font-medium">
        <span>Offer Comparator</span>
        <span class="text-indigo-600 font-semibold">Hike Tool</span>
      </div>
    </a>
  </div>
</section>
