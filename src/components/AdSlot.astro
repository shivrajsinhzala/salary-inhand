---
interface Props {
  slot?: string;
  format?: 'horizontal' | 'rectangle' | 'auto';
  className?: string;
}

const { slot = '7164999486301748', format = 'auto', className = '' } = Astro.props;
const CLIENT = 'ca-pub-7164999486301748';

// Preset min heights to preserve layout geometry & prevent CLS (Cumulative Layout Shift)
const minHeightClass = format === 'horizontal' ? 'min-h-[100px]' : format === 'rectangle' ? 'min-h-[260px]' : 'min-h-[110px]';
---
<div class={`ad-slot-wrapper no-print my-6 w-full ${className}`}>
  <div class={`ad-slot-card w-full border border-dashed border-slate-200 bg-slate-50/50 rounded-xl p-2.5 flex flex-col items-center justify-center ${minHeightClass}`}>
    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1.5 pointer-events-none">
      Advertisement
    </span>
    <ins 
      class="adsbygoogle w-full block text-center"
      style="display:block"
      data-ad-client={CLIENT}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {}
    </script>
  </div>
</div>
