---
import { POPULAR_SLABS } from '../data/salaries.data.mjs';
import { TAX_QUERY_SLABS } from '../data/taxes.data.mjs';
import { CONTENT_UPDATED_LABEL } from '../lib/site.js';

const topSlabs = POPULAR_SLABS.filter(s => s.popular);
// Sitewide entry points into the income-tax cluster so it is not crawl-orphaned.
const topTaxSlabs = TAX_QUERY_SLABS.filter(s =>
  ['7-lakh', '10-lakh', '12-lakh', '15-lakh', '20-lakh', '30-lakh'].includes(s.slug)
);
---
<footer class="mt-auto border-t border-slate-200 bg-white pt-12 pb-8 text-slate-600">
  <div class="container">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <div class="space-y-3 lg:col-span-1 sm:col-span-2">
        <a href="/" class="flex items-center gap-1 text-xl font-extrabold tracking-tight text-slate-900">
          <span>InHand</span><span class="text-teal-600">.</span>
        </a>
        <p class="text-sm leading-relaxed text-slate-500">
          Precision in-hand salary, income tax regime comparison, loan affordability, and wealth compounding calculators built for Indian working professionals.
        </p>
        <p class="text-xs text-slate-400">
          Calculations verified against Income Tax Department (Finance Act FY 2025–26 & FY 2026–27).
        </p>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Popular Salary Slabs</h3>
        <ul class="space-y-1.5 text-sm">
          {topSlabs.slice(0, 7).map(slab => (
            <li>
              <a href={`/in-hand-salary/${slab.slug}/`} class="hover:text-teal-700 transition-colors">
                {slab.label} In-Hand Salary
              </a>
            </li>
          ))}
          <li>
            <a href="/in-hand-salary/" class="text-teal-700 font-semibold hover:underline">
              View all 40+ salary slabs →
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Income Tax by Salary</h3>
        <ul class="space-y-1.5 text-sm">
          {topTaxSlabs.map(slab => (
            <li>
              <a href={`/income-tax/${slab.slug}/`} class="hover:text-teal-700 transition-colors">
                Tax on {slab.label} Salary
              </a>
            </li>
          ))}
          <li>
            <a href="/income-tax/" class="text-teal-700 font-semibold hover:underline">
              View all tax brackets →
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Financial Calculators</h3>
        <ul class="space-y-1.5 text-sm">
          <li><a href="/" class="hover:text-teal-700 transition-colors">In-Hand Salary Calculator</a></li>
          <li><a href="/tools/home-loan-emi/" class="hover:text-teal-700 transition-colors">Home Loan EMI & Prepayment</a></li>
          <li><a href="/tools/sip-calculator/" class="hover:text-teal-700 transition-colors">Step-Up SIP Calculator</a></li>
          <li><a href="/tools/salary-hike/" class="hover:text-teal-700 transition-colors">Salary Hike / Increment</a></li>
          <li><a href="/in-hand-salary/" class="hover:text-teal-700 transition-colors">CTC to Gross Directory</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">About & Transparency</h3>
        <ul class="space-y-1.5 text-sm">
          <li><a href="/privacy/" class="hover:text-teal-700 transition-colors">Privacy Policy</a></li>
          <li><a href="/methodology/" class="hover:text-teal-700 transition-colors">Calculation Methodology</a></li>
          <li><a href="https://tracker.shivrajsinh.in" target="_blank" rel="noopener" class="hover:text-teal-700 transition-colors">GSRTC Bus Tracker</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} InHand. Part of shivrajsinh.in network. Tax rules last reviewed {CONTENT_UPDATED_LABEL}.</p>
      <p>Disclaimer: Calculations are for estimation purposes based on standard tax rules. Verify with your payroll specialist.</p>
    </div>
  </div>
</footer>
