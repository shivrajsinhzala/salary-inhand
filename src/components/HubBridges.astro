---
interface Props {
  monthlyInHand?: number;
}

const { monthlyInHand = 80000 } = Astro.props;
const estimatedLoanLakhs = Math.round((monthlyInHand * 0.50 * 115) / 100000);
const suggestedSip = Math.round(monthlyInHand * 0.20);
---
<section class="my-10 pt-8 border-t border-slate-200">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
    <div>
      <span class="text-[11px] font-semibold tracking-wider text-teal-800 uppercase bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200/60">
        Financial Planning Suite
      </span>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mt-2 tracking-tight">
        Plan Your Next Financial Milestone
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
        Contextual projections modeled directly on your monthly take-home salary.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Bridge 1: Home Loan -->
    <a 
      href="/tools/home-loan-emi/" 
      class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-teal-600 hover:shadow-md transition-all flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center group-hover:bg-teal-50 group-hover:text-teal-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-slate-400 group-hover:text-teal-700 group-hover:translate-x-0.5 transition-all flex items-center gap-1">
            Calculate
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-teal-700 transition-colors text-base">
          Home Loan Affordability
        </h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
          Based on your take-home, you could qualify for up to <strong class="text-slate-800 font-semibold">₹{estimatedLoanLakhs} Lakhs</strong> in home loan. See how prepaying saves ₹10L+ interest.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium">
        <span>Standard 50% FOIR</span>
        <span class="text-teal-700 font-semibold">Loan EMI Tool</span>
      </div>
    </a>

    <!-- Bridge 2: Step-Up SIP -->
    <a 
      href="/tools/sip-calculator/" 
      class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-teal-600 hover:shadow-md transition-all flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center group-hover:bg-teal-50 group-hover:text-teal-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-slate-400 group-hover:text-teal-700 group-hover:translate-x-0.5 transition-all flex items-center gap-1">
            Simulate
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-teal-700 transition-colors text-base">
          Step-Up SIP Compounder
        </h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
          Investing 20% (<strong class="text-slate-800 font-semibold">₹{suggestedSip.toLocaleString('en-IN')}/mo</strong>) with a 10% annual increment can build long-term financial independence.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium">
        <span>12% Assumed CAGR</span>
        <span class="text-teal-700 font-semibold">Wealth Tool</span>
      </div>
    </a>

    <!-- Bridge 3: Salary Hike -->
    <a 
      href="/tools/salary-hike/" 
      class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-teal-600 hover:shadow-md transition-all flex flex-col justify-between"
    >
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center group-hover:bg-teal-50 group-hover:text-teal-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <span class="text-xs font-semibold text-slate-400 group-hover:text-teal-700 group-hover:translate-x-0.5 transition-all flex items-center gap-1">
            Evaluate
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </span>
        </div>
        <h3 class="font-bold text-slate-900 group-hover:text-teal-700 transition-colors text-base">
          Salary Hike & Appraisal
        </h3>
        <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
          Evaluating a 20%, 30%, or 50% job offer jump? Find out exactly how much net cash increases in your bank account after tax.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium">
        <span>Offer Comparator</span>
        <span class="text-teal-700 font-semibold">Hike Tool</span>
      </div>
    </a>
  </div>
</section>
